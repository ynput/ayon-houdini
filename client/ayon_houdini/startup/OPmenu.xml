<?xml version="1.0" encoding="UTF-8"?>
<!-- OPMenu Stencil.
    It's used to extend the OPMenu.
-->

<menuDocument>
    <menu>
        <!-- Operator type and asset options. -->

        <scriptItem id="opmenu.vhda_create_ayon">
            <insertAfter>opmenu.vhda_create</insertAfter>
            <label>Create Digital Asset (AYON)...</label>
            <context>
                <expression>kwargs["node"].canCreateDigitalAsset()</expression>
            </context>
            <scriptCode>
<![CDATA[
from ayon_houdini.api.creator_node_shelves import create_interactive

node = kwargs["node"]
if node not in hou.selectedNodes():
    node.setSelected(True)
create_interactive("io.openpype.creators.houdini.hda", **kwargs)
]]>
            </scriptCode>
        </scriptItem>

        <scriptItem id="opmenu.ayon_publish_reset_error">
            <insertAfter>opmenu.vhda_create</insertAfter>
            <label>Reset AYON Publish Error</label>
            <context>
                <expression><![CDATA[
from ayon_houdini.api import ayon_publish
return ayon_publish.has_node_error(kwargs["node"])
]]></expression>
            </context>
            <scriptCode><![CDATA[
from ayon_houdini.api import ayon_publish
ayon_publish.clear_node_error(kwargs["node"])
]]></scriptCode>
        </scriptItem>
    </menu>
</menuDocument>
