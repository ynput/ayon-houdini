import os


def _expand_parm(node, name):
    return hou.expandString(node.evalParm(name)).rstrip("/\\")


def _cache_dir(node):
    resolved = hou.expandString(node.evalParm("resolvedPath"))
    if resolved:
        return resolved

    base = os.path.join(
        _expand_parm(node, "cacheRoot"),
        _expand_parm(node, "folderPath").lstrip("/\\"),
        _expand_parm(node, "task"),
        _expand_parm(node, "cacheName"),
    )
    if node.evalParm("enableVersion"):
        base = os.path.join(base, "v%03d" % node.evalParm("version"))
    return base


def _check_overwrite(node):
    if node.evalParm("overwriteExisting"):
        return True

    if node.evalParm("filemethod"):
        cache = node.node("filecache1")
        if cache is not None:
            target = hou.expandString(cache.evalParm("sopoutput"))
            if os.path.isfile(target):
                raise hou.Error(
                    "Cache already exists: {}. Enable Overwrite Existing "
                    "Cache or use another Geometry File.".format(target)
                )
        return True

    target = _cache_dir(node)
    if not os.path.isdir(target):
        return True

    if not any(os.scandir(target)):
        return True

    raise hou.Error(
        "Cache already exists: {}. Enable Overwrite Existing Cache "
        "or use Next Version.".format(target)
    )

def save_cache(node):
    """Save the input geometry through the inner File Cache."""
    _check_overwrite(node)

    cache = node.node("filecache1")
    if cache is not None:
        cache.parm("execute").pressButton()


def save_background(node):
    """Save the input geometry through the background cache button."""
    _check_overwrite(node)

    cache = node.node("filecache1")
    if cache is not None:
        cache.parm("cookoutputnode").pressButton()


def cancel_cook(node):
    """Cancel the running File Cache cook."""
    cache = node.node("filecache1")
    if cache is not None:
        cache.parm("dirtyall").pressButton()


def reload_geometry(node):
    """Reload the cached geometry from disk."""
    cache = node.node("filecache1")
    if cache is not None:
        cache.parm("reload").pressButton()


def next_version(node):
    """Set the version to the next free version folder."""
    import os
    import re

    def expand(parm_name):
        return hou.expandString(node.evalParm(parm_name)).rstrip("/\\")

    folder = expand("folderPath").lstrip("/\\")
    base = os.path.join(
        expand("cacheRoot"), folder, expand("task"), expand("cacheName")
    )
    next_version = 1
    if os.path.isdir(base):
        for name in os.listdir(base):
            match = re.match(r"^v(\d+)$", name)
            if match:
                next_version = max(next_version, int(match.group(1)) + 1)
    node.parm("version").set(next_version)
