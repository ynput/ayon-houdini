Content-Disposition: attachment; filename="hdaroot/read_input.parm"
Content-Type: text/plain

{
version 0.8
python	[ 0	locks=0 ]	(	"node = hou.pwd()
parent = node.parent()
node.geometry().clear()
inputs = parent.inputs()
if inputs:
    node.geometry().merge(inputs[0].geometry())
"	)
maintainstate	[ 0	locks=0 ]	(	"off"	)
}

