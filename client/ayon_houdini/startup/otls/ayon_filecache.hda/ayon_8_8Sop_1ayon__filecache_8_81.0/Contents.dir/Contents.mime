--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/filecache1.chn"
Content-Type: text/plain

{
    channel f1 {
      lefttype = extend
      righttype = extend
      flags = 0
      start = 40
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"../f1\") }
    }
    channel f2 {
      lefttype = extend
      righttype = extend
      flags = 0
      start = 40
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"../f2\") }
    }
    channel clampfirst {
      lefttype = extend
      righttype = extend
      flags = 0
      start = 40
      segment { length = 0 expr = ch(\"f1\") }
    }
    channel clamplast {
      lefttype = extend
      righttype = extend
      flags = 0
      start = 40
      segment { length = 0 expr = ch(\"f2\") }
    }
    channel index {
      lefttype = extend
      righttype = extend
      flags = 0
      start = 40
      segment { length = 0 expr = $FF-1 }
    }
    channel frame {
      lefttype = extend
      righttype = extend
      flags = 0
      start = 40
      segment { length = 0 expr = "{
    if(ch(\"timedependent\"))
    {
        rawframe = $T * $FPS + 1;
        rawframe -= ch(\"f1\");
        rawframe *= ch(\"substeps\") / ch(\"f3\");
        rawframe = rint(rawframe);
        rawframe /= ch(\"substeps\") / ch(\"f3\");
        rawframe += ch(\"f1\");
        if(ch(\"doclampfirst\") && ch(\"doclamplast\")) return clamp(rawframe,ch(\"clampfirst\"),ch(\"clamplast\"));
        if(ch(\"doclampfirst\")) return max(ch(\"clampfirst\"),rawframe);
        if(ch(\"doclamplast\")) return min(ch(\"clamplast\"),rawframe);
        return rawframe;
    }
    else
    {
        return 1;
    }
}" }
    }
    channel descriptivelabel {
      lefttype = extend
      righttype = extend
      defaultString = \"\"
      flags = 0
      start = 40
      segment { length = 0 expr = "ifs(ch(\"filemethod\"),chsraw(\"file\"),strreplace(strreplace(chs(\"cachename\"),chs(\"basename\"),chsraw(\"basename\")),chs(\"framestr\"),\".\" + '$F' + 4))" }
    }
    channel sopoutput {
      lefttype = extend
      righttype = extend
      defaultString = \"\"
      flags = 0
      start = 40
      segment { length = 0 expr = "{
    if(ch('filemethod'))
    {
        return chs('file');
    }
    else
    {
        return chs('cachedir') + '/' + chs('cachename');
    }
}" }
    }
    channel basedir {
      lefttype = extend
      righttype = extend
      defaultString = \"$HIP/geo\"
      flags = 0
      segment { options = {	 autoslope  ai ao }

	 length = 0 accel = 0.33333333333333331 0.33333333333333331 expr = "chs(\"../cacheRoot\") + chs(\"../folderPath\") + \"/\" + chs(\"../task\")" }
    }
    channel basename {
      lefttype = extend
      righttype = extend
      defaultString = \"$HIPNAME.$OS\"
      flags = 0
      segment { options = {	 autoslope  ai ao }

	 length = 0 accel = 0.33333333333333331 0.33333333333333331 expr = chs(\"../cacheName\") }
    }
    channel enableversion {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"../enableVersion\") }
    }
    channel version {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"../version\") }
    }
    channel trange {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"../trange\") }
    }
    channel cachesim {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"../cachesim\") }
    }
    channel f3 {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"../f3\") }
    }
    channel substeps {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"../substeps\") }
    }
    channel loadtype {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"../loadtype\") }
    }
    channel loadfromdisk {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"../loadfromdisk\") }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
