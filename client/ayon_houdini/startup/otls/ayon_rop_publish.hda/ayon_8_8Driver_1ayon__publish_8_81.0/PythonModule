def run(*args, **kwargs):
    import importlib
    from ayon_houdini.api import ayon_publish

    importlib.reload(ayon_publish)
    ayon_publish.ayon_publish_command(*args, **kwargs)


def run_after_render(*args, **kwargs):
    """Increment the workfile after a successful publish render."""
    import importlib

    import hou

    from ayon_houdini.api import ayon_publish

    importlib.reload(ayon_publish)
    ayon_publish.after_publish_render(hou.pwd(), *args, **kwargs)


def get_product_type_menu(node):
    """Return the product types for the node's productType menu."""
    from ayon_houdini.api import ayon_publish

    return ayon_publish.get_product_type_menu()


def save_publish_report(node):
    """Save the node's stored publish report to a JSON file."""
    import importlib
    from ayon_houdini.api import hda_utils

    importlib.reload(hda_utils)
    hda_utils.save_publish_report(node)


def copy_publish_report(node):
    """Copy the node's stored publish report to the clipboard."""
    import importlib
    from ayon_houdini.api import hda_utils

    importlib.reload(hda_utils)
    hda_utils.copy_publish_report(node)
